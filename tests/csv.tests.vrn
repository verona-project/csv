(import base)
(import testing)
(import testing :as t)
(import allocator :as a)
(import system_allocator :as system)
(import arena)
(import data :as d)
(import error :as e)

(base:variable budget u64 1000000)

(base:variable live u64 0)

(base:function acquire ((context (pointer void)) (size u64) (alignment u64)) a:result
  (match (== budget 0)
    (true (a:failure (out-of-memory)))
    (false
      (do
        (assign budget (- budget 1))
        (match (a:allocate (system:create) size alignment)
          ((failed reason) (a:failure reason))
          ((allocated p) (do (assign live (+ live 1)) (a:success p))))))))

(base:function release ((context (pointer void)) (p (pointer u8)) (size u64) (alignment u64)) unit
  (do (assign live (- live 1)) (a:deallocate (system:create) p size alignment)))

(base:function backend () a:backend
  (a:backend (cast (pointer void) "") acquire release))

(base:function ok ((status e:status)) bool
  (match status ((ok) true) (_ false)))

(base:function append ((out (pointer d:data)) (source d:view) (at u64)) unit
  (match (== at (field source length))
    (true (do (d:append out #\|) unit))
    (false
      (do
        (d:append out (deref (pointer-offset (field source bytes) at)))
        (append out source (+ at 1))))))

(import csv :as f)

(base:variable row-total u64 0)

(base:variable column-total u64 0)

(base:function emit ((context (pointer void)) (row u64) (column u64) (value d:view)) unit
  (do
    (assign row-total (+ row-total row))
    (assign column-total (+ column-total column))
    (append (cast (pointer d:data) context) value 0)))

(base:function check-parse ((source d:view) (valid bool) (expected d:view)) t:result
  (let
    ((captured d:data (d:empty (system:create)))
     (parsed
       f:result
       (f:parse source (backend) (f:visitor (cast (pointer void) (address-of captured)) emit)))
     (checks
       t:result
       (t:checks
         (t:check
           (match valid
             (true (ok (field parsed status)))
             (false (base:not (ok (field parsed status))))))
         (match valid (true (t:check (d:equal (d:borrow captured) expected))) (false (t:empty)))
         (t:check
           (match valid
             (true (== (field parsed offset) (field source length)))
             (false (<= (field parsed offset) (field source length))))))))
    (do (d:destroy (address-of captured)) checks)))

(t:test valid-empty-document
  (check-parse (d:view "" 0) true (d:view "" 0)))

(t:test valid-crlf-and-lf
  (let ((fixture-0 (array u8 9) (array-of #\a #\, #\b #\return #\newline #\c #\, #\d #\newline)))
    (check-parse (d:view (address-of (index fixture-0 0)) 9) true (d:view "a|b|c|d|" 8))))

(t:test valid-empty-fields
  (check-parse (d:view "," 1) true (d:view "||" 2)))

(t:test valid-blank-record
  (check-parse (d:view "\n" 1) true (d:view "|" 1)))

(t:test valid-trailing-empty-field
  (check-parse (d:view "a," 2) true (d:view "a||" 3)))

(t:test valid-quoted-comma-quote-newline
  (check-parse (d:view "\"a,b\",\"a\"\"b\",\"a\nb\"" 18) true (d:view "a,b|a\"b|a\nb|" 12)))

(t:test valid-empty-quoted-field
  (check-parse (d:view "\"\"" 2) true (d:view "|" 1)))

(t:test valid-unicode-and-spaces
  (let
    ((fixture-1 (array u8 6) (array-of 195 169 #\, #\space #\x #\space))
     (fixture-2 (array u8 7) (array-of 195 169 #\| #\space #\x #\space #\|)))
    (check-parse
      (d:view (address-of (index fixture-1 0)) 6)
      true
      (d:view (address-of (index fixture-2 0)) 7))))

(t:test valid-final-newline
  (let ((fixture-3 (array u8 3) (array-of #\a #\return #\newline)))
    (check-parse (d:view (address-of (index fixture-3 0)) 3) true (d:view "a|" 2))))

(t:test valid-quoted-crlf
  (let
    ((fixture-4 (array u8 6) (array-of #\" #\a #\return #\newline #\b #\"))
     (fixture-5 (array u8 5) (array-of #\a #\return #\newline #\b #\|)))
    (check-parse
      (d:view (address-of (index fixture-4 0)) 6)
      true
      (d:view (address-of (index fixture-5 0)) 5))))

(t:test invalid-unterminated-field
  (check-parse (d:view "\"unterminated" 13) false (d:view "" 0)))

(t:test invalid-quote-in-unquoted-field
  (check-parse (d:view "a\"b" 3) false (d:view "" 0)))

(t:test invalid-suffix-after-quote
  (check-parse (d:view "\"a\"x" 4) false (d:view "" 0)))

(t:test invalid-space-after-quote
  (check-parse (d:view "\"a\" " 4) false (d:view "" 0)))

(t:test invalid-bare-cr
  (let ((fixture-6 (array u8 3) (array-of #\a #\return #\b)))
    (check-parse (d:view (address-of (index fixture-6 0)) 3) false (d:view "" 0))))

(t:test invalid-quoted-bare-cr
  (let ((fixture-7 (array u8 4) (array-of #\" #\a #\" #\return)))
    (check-parse (d:view (address-of (index fixture-7 0)) 4) false (d:view "" 0))))

(t:test invalid-lone-quote
  (check-parse (d:view "\"" 1) false (d:view "" 0)))

(t:test invalid-later-unterminated-field
  (check-parse (d:view "a,\"x" 4) false (d:view "" 0)))

(t:test invalid-utf8
  (let ((byte u8 255)) (check-parse (d:view (address-of byte) 1) false (d:view "" 0))))

(t:test writer
  (let
    ((fixture-8
       (array u8 13)
       (array-of #\" #\a #\, #\" #\" #\b #\newline #\" #\, #\" #\" #\return #\newline)))
    (let
      ((owner arena:arena (arena:create (system:create) 64))
       (out d:data (d:empty (arena:allocator (address-of owner))))
       (status
         e:status
         (do
           (f:write-field (d:view "a,\"b\n" 5) (address-of out))
           (f:write-separator (address-of out))
           (f:write-field (d:view "" 0) (address-of out))
           (f:write-record-end (address-of out))))
       (checks
         t:result
         (t:checks
           (t:check (ok status))
           (t:check (d:equal (d:borrow out) (d:view (address-of (index fixture-8 0)) 13))))))
      (do (d:destroy (address-of out)) (arena:destroy (address-of owner)) checks))))

(t:test writer-allocation-failure
  (do
    (assign budget 1000)
    (let ((out d:data (d:empty (backend))) (seed e:status (d:append (address-of out) #\x)))
      (do
        (assign budget 0)
        (let
          ((status
             e:status
             (f:write-field (d:view "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" 40) (address-of out)))
           (checks
             t:result
             (t:checks
               (t:check (match status ((allocation-error _) true) (_ false)))
               (t:check (d:equal (d:borrow out) (d:view "x" 1))))))
          (do
            (d:destroy (address-of out))
            (assign budget 1000000)
            (t:checks checks (t:check (== live 0)))))))))

(t:test allocation-failure-0
  (do
    (assign budget 0)
    (let
      ((captured d:data (d:empty (system:create)))
       (parsed
         f:result
         (f:parse
           (d:view "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" 40)
           (backend)
           (f:visitor (cast (pointer void) (address-of captured)) emit)))
       (checks
         t:result
         (t:checks
           (t:check (match (field parsed status) ((allocation-error _) true) (_ false)))
           (t:check (== live 0)))))
      (do (d:destroy (address-of captured)) (assign budget 1000000) checks))))

(t:test allocation-failure-1
  (do
    (assign budget 1)
    (let
      ((captured d:data (d:empty (system:create)))
       (parsed
         f:result
         (f:parse
           (d:view "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" 40)
           (backend)
           (f:visitor (cast (pointer void) (address-of captured)) emit)))
       (checks
         t:result
         (t:checks
           (t:check (match (field parsed status) ((allocation-error _) true) (_ false)))
           (t:check (== live 0)))))
      (do (d:destroy (address-of captured)) (assign budget 1000000) checks))))

(t:test callback-coordinates
  (do
    (assign row-total 0)
    (assign column-total 0)
    (let ((checks t:result (check-parse (d:view "a,b\nc,d\ne" 9) true (d:view "a|b|c|d|e|" 10))))
      (t:checks checks (t:check (== row-total 4)) (t:check (== column-total 2))))))

(t:test arena-parser
  (let
    ((owner arena:arena (arena:create (system:create) 32))
     (captured d:data (d:empty (system:create)))
     (parsed
       f:result
       (f:parse
         (d:view "a,\"b\"\n" 6)
         (arena:allocator (address-of owner))
         (f:visitor (cast (pointer void) (address-of captured)) emit)))
     (checks
       t:result
       (t:checks
         (t:check (ok (field parsed status)))
         (t:check (d:equal (d:borrow captured) (d:view "a|b|" 4))))))
    (do (d:destroy (address-of captured)) (arena:destroy (address-of owner)) checks)))

(t:runner main
  (callback-coordinates)
  (arena-parser)
  (valid-empty-document)
  (valid-crlf-and-lf)
  (valid-empty-fields)
  (valid-blank-record)
  (valid-trailing-empty-field)
  (valid-quoted-comma-quote-newline)
  (valid-empty-quoted-field)
  (valid-unicode-and-spaces)
  (valid-final-newline)
  (valid-quoted-crlf)
  (invalid-unterminated-field)
  (invalid-quote-in-unquoted-field)
  (invalid-suffix-after-quote)
  (invalid-space-after-quote)
  (invalid-bare-cr)
  (invalid-quoted-bare-cr)
  (invalid-lone-quote)
  (invalid-later-unterminated-field)
  (invalid-utf8)
  (writer)
  (writer-allocation-failure)
  (allocation-failure-0)
  (allocation-failure-1))
