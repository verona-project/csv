(static-library csv
  (version "0.1.0") (root csv)
  (module-path "src") (module-path "../base/src")
  (module-path "../foundation/src") (optimize 2))

(executable csv-tests
  (root csv.tests) (module-path "src") (module-path "tests")
  (module-path "../base/src") (module-path "../foundation/src")
  (module-path "../testing/src") (optimize 2))
